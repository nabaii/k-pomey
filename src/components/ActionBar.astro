---
/**
 * §5.10 MOBILE ACTION BAR — fixed bottom bar below 821px: a page-appropriate
 * secondary action plus WhatsApp us. §6.2 route 1, the fastest path to a
 * human and the one that is always visible.
 *
 * The body carries bottom padding equal to the bar height plus
 * env(safe-area-inset-bottom); see Base.astro.
 */
import { waLink } from '../lib/site';

interface Props {
  secondaryHref: string;
  secondaryLabel: string;
  /** The pre-written WhatsApp message for this page. */
  message: string;
}
const { secondaryHref, secondaryLabel, message } = Astro.props;
---

<nav class="bar" aria-label="Quick actions">
  <a href={secondaryHref}>{secondaryLabel}</a>
  <a class="wa" href={waLink(message)} target="_blank" rel="noopener">
    <!-- §6.2 route 1. The mark is read faster than the word and survives at a
         size the label cannot, which is the whole job of this cell. Drawn in
         currentColor so it stays inside the palette (§4.1) — no brand green. -->
    <svg viewBox="0 0 24 24" width="17" height="17" fill="currentColor" aria-hidden="true">
      <path
        d="M12.04 2C6.58 2 2.13 6.45 2.13 11.91c0 1.75.46 3.46 1.32 4.96L2 22l5.25-1.38a9.9 9.9 0 0 0 4.79 1.22h.01c5.46 0 9.91-4.45 9.91-9.91 0-2.65-1.03-5.14-2.9-7.01A9.82 9.82 0 0 0 12.04 2Zm0 18.15h-.01a8.2 8.2 0 0 1-4.19-1.15l-.3-.18-3.12.82.83-3.04-.2-.31a8.17 8.17 0 0 1-1.26-4.38c0-4.54 3.7-8.24 8.25-8.24a8.2 8.2 0 0 1 8.24 8.25c0 4.54-3.7 8.23-8.24 8.23Zm4.52-6.16c-.25-.12-1.47-.72-1.69-.81-.23-.08-.39-.12-.56.13-.16.24-.64.8-.78.97-.14.16-.29.18-.54.06-.25-.13-1.05-.39-1.99-1.23-.74-.66-1.23-1.47-1.38-1.72-.14-.25-.01-.38.11-.5.11-.11.25-.29.37-.43.13-.15.17-.25.25-.41.08-.17.04-.31-.02-.44-.06-.12-.56-1.34-.76-1.84-.2-.48-.4-.42-.56-.43h-.47c-.17 0-.43.06-.66.31-.23.25-.86.85-.86 2.07s.89 2.4 1.01 2.56c.12.17 1.75 2.67 4.23 3.74.59.26 1.05.41 1.41.52.59.19 1.13.16 1.56.1.47-.07 1.47-.6 1.68-1.18.21-.58.21-1.08.14-1.18-.06-.11-.22-.17-.47-.29Z"
      />
    </svg>
    <span>WhatsApp us</span>
  </a>
</nav>

<style>
  .bar {
    position: fixed;
    left: 0;
    right: 0;
    bottom: 0;
    z-index: 40;
    display: grid;
    /* Not 1fr 1fr. An even split gave a secondary page link the same weight as
       the only always-visible route to a human (§6.2), and the WhatsApp cell
       has a glyph and a label to seat. */
    grid-template-columns: 0.85fr 1.15fr;
    border-top: 1px solid var(--sumi);
    padding-bottom: env(safe-area-inset-bottom);
  }
  a {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 10px;
    min-height: var(--bar-h);
    padding-inline: 10px;
    background: var(--washi);
    color: var(--sumi);
    font-size: var(--t-eyebrow);
    letter-spacing: 0.18em;
    text-transform: uppercase;
    text-align: center;
    text-decoration: none;
  }
  .wa { background: var(--niwa); color: var(--washi); }  /* 5.44:1 */
  .wa svg { flex: none; }

  /* Narrowest phones: the label wraps before the glyph would ever drop, and a
     two-line cell breaks the bar's height. The mark carries it alone, with the
     accessible name coming from the link text. */
  @media (max-width: 359px) {
    .wa span {
      position: absolute;
      width: 1px; height: 1px;
      overflow: hidden;
      clip-path: inset(50%);
      white-space: nowrap;
    }
    .wa svg { width: 21px; height: 21px; }
  }

  @media (min-width: 821px) {
    .bar { display: none; }
  }
</style>
