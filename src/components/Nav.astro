---
/**
 * §5.1 NAVIGATION — sticky header on every page. Below 981px the links and
 * button collapse into a full-screen drawer with Mincho-set entries.
 * §9 — the drawer is role="dialog" aria-modal, closes on Escape, toggles
 * aria-expanded, locks body scroll and traps focus.
 */
import BrandMark from './BrandMark.astro';
import Action from './Action.astro';

interface Props {
  inverted?: boolean;
}
const { inverted = false } = Astro.props;

const links = [
  { href: '/work/', label: 'Work' },
  { href: '/flowers/', label: 'Flowers' },
  { href: '/care/', label: 'Care' },
  { href: '/studio/', label: 'Studio' },
];

const path = Astro.url.pathname.replace(/\/+$/, '') + '/';
const isCurrent = (href: string) => path === href || (href !== '/' && path.startsWith(href));
---

<header class:list={['nav', { inv: inverted }]}>
  <div class="nav-in">
    <!-- No aria-label: the visible brand text is the accessible name. An
         aria-label saying "and" over text reading "&" is a name mismatch,
         and leaves voice-control users unable to say what they can see. -->
    <a class="brand" href="/">
      <BrandMark inverted={inverted} />
      <span class="brand-tx">
        <b>K. Pomey</b>
        <i>Landscaping &amp; Alatu</i>
      </span>
    </a>

    <nav class="nav-links" aria-label="Primary">
      {
        links.map((l) => (
          <a href={l.href} aria-current={isCurrent(l.href) ? 'page' : undefined}>
            {l.label}
          </a>
        ))
      }
    </nav>

    <Action href="/studio/#contact" class="nav-cta">Book a site visit</Action>

    <button
      class="burger"
      id="nav-burger"
      type="button"
      aria-expanded="false"
      aria-controls="nav-drawer"
      aria-label="Open menu"
    >
      <span></span><span></span><span></span>
    </button>
  </div>
</header>

<div
  class="drawer"
  id="nav-drawer"
  role="dialog"
  aria-modal="true"
  aria-label="Menu"
  hidden
>
  <div class="drawer-top">
    <button class="drawer-close" type="button" aria-label="Close menu">&#215;</button>
  </div>
  <nav aria-label="Menu">
    {
      links.map((l) => (
        <a href={l.href} aria-current={isCurrent(l.href) ? 'page' : undefined}>
          {l.label}
        </a>
      ))
    }
    <a class="drawer-cta" href="/studio/#contact">Book a site visit</a>
  </nav>
  <p class="drawer-foot">Area 1, Abuja &middot; FCT</p>
</div>

<script>
  const burger = document.getElementById('nav-burger');
  const drawer = document.getElementById('nav-drawer');

  if (burger && drawer) {
    const focusables = () =>
      Array.from(
        drawer.querySelectorAll<HTMLElement>('a[href], button:not([disabled])'),
      ).filter((el) => el.offsetParent !== null);

    let lastFocused: HTMLElement | null = null;
    let scrollY = 0;

    const reduced = matchMedia('(prefers-reduced-motion: reduce)').matches;

    /**
     * body{overflow:hidden} does not hold behind a fixed overlay in iOS
     * Safari — the page keeps rubber-banding underneath the drawer. Pinning
     * the body at a negative offset does, and restoring the offset on close
     * puts the reader back exactly where they were. The restore has to be
     * instant, or the global scroll-behavior:smooth animates it.
     */
    const lockScroll = () => {
      scrollY = window.scrollY;
      document.body.style.position = 'fixed';
      document.body.style.top = `-${scrollY}px`;
      document.body.style.width = '100%';
    };

    const unlockScroll = () => {
      document.body.style.position = '';
      document.body.style.top = '';
      document.body.style.width = '';
      window.scrollTo({ top: scrollY, behavior: 'instant' as ScrollBehavior });
    };

    const open = () => {
      lastFocused = document.activeElement as HTMLElement;
      lockScroll();
      drawer.hidden = false;
      // Read a layout value so the browser paints the closed state before the
      // class lands; without it the transition is skipped and this reverts to
      // the hard cut it replaced.
      void drawer.offsetWidth;
      drawer.classList.add('is-open');
      burger.setAttribute('aria-expanded', 'true');
      focusables()[0]?.focus();
    };

    const close = () => {
      drawer.classList.remove('is-open');
      burger.setAttribute('aria-expanded', 'false');
      unlockScroll();
      lastFocused?.focus();

      // Keep it in the tree until the fade finishes, then take it out so it
      // leaves the tab order. Re-opening mid-fade cancels the hide.
      if (reduced) {
        drawer.hidden = true;
      } else {
        setTimeout(() => {
          if (!drawer.classList.contains('is-open')) drawer.hidden = true;
        }, 280);
      }
    };

    burger.addEventListener('click', open);
    drawer.querySelector('.drawer-close')?.addEventListener('click', close);
    drawer.querySelectorAll('nav a').forEach((a) => a.addEventListener('click', close));

    document.addEventListener('keydown', (e) => {
      if (drawer.hidden) return;
      if (e.key === 'Escape') {
        close();
        return;
      }
      // Focus trap — the dialog is modal, so Tab must not leave it.
      if (e.key === 'Tab') {
        const items = focusables();
        if (!items.length) return;
        const first = items[0]!;
        const last = items[items.length - 1]!;
        if (e.shiftKey && document.activeElement === first) {
          e.preventDefault();
          last.focus();
        } else if (!e.shiftKey && document.activeElement === last) {
          e.preventDefault();
          first.focus();
        }
      }
    });
  }
</script>

<style>
  /* Opaque below 981px. A blurred backdrop on a sticky element repaints the
     region behind it on every frame of a momentum scroll, which is the exact
     cost §3.1 spends the whole build avoiding on mid-range Android. At this
     size the header is 64px of a narrow screen and the translucency reads as
     nothing, so it buys no look to pay for. */
  .nav {
    position: sticky;
    top: 0;
    z-index: 30;
    background: var(--washi);
    border-bottom: 1px solid var(--line);
  }
  .nav.inv {
    background: var(--sumi);
    border-bottom-color: var(--line-inv);
    color: var(--washi);
  }
  @media (min-width: 981px) {
    .nav {
      background: color-mix(in srgb, var(--washi) 88%, transparent);
      backdrop-filter: blur(8px);
    }
    .nav.inv { background: color-mix(in srgb, var(--sumi) 88%, transparent); }
  }
  .nav-in {
    display: flex;
    align-items: center;
    gap: 24px;
    height: 64px;
    max-width: var(--container);
    margin-inline: auto;
    padding-inline: var(--gutter);
  }

  .brand {
    display: flex;
    align-items: center;
    gap: 11px;
    margin-right: auto;
    text-decoration: none;
  }
  .brand b {
    display: block;
    font-family: var(--font-display);
    font-size: 0.9375rem;
    font-weight: 500;
    letter-spacing: 0.06em;
    line-height: 1.1;
  }
  .brand i {
    display: block;
    font-style: normal;
    font-size: 0.5rem;
    letter-spacing: 0.2em;
    text-transform: uppercase;
    line-height: 1.6;
    color: var(--koke-d);
  }
  .inv .brand i { color: var(--koke); }

  .nav-links { display: none; gap: 26px; }
  .nav-links a {
    padding: 6px 0;
    border-bottom: 1px solid transparent;
    font-size: var(--t-eyebrow);
    letter-spacing: 0.2em;
    text-transform: uppercase;
    text-decoration: none;
  }
  .nav-links a:hover { color: var(--niwa); }
  .inv .nav-links a:hover { color: var(--niwa-2); }
  .nav-links a[aria-current='page'] { border-bottom-color: var(--niwa); }
  .inv .nav-links a[aria-current='page'] { border-bottom-color: var(--niwa-2); }

  .nav :global(.nav-cta) { display: none; }

  .burger {
    display: grid;
    place-content: center;
    gap: 4px;
    width: 44px;
    height: 44px;
    padding: 0;
    background: none;
    border: 1px solid var(--line);
    cursor: pointer;
  }
  .inv .burger { border-color: var(--line-inv); }
  .burger span { display: block; width: 16px; height: 1px; background: currentColor; }

  /* §8 — header links and button appear at 981px; burger hidden. */
  @media (min-width: 981px) {
    .nav-in { height: 72px; }
    .nav-links { display: flex; }
    .nav :global(.nav-cta) { display: inline-flex; }
    .burger { display: none; }
  }

  .drawer {
    position: fixed;
    inset: 0;
    z-index: 60;
    display: flex;
    flex-direction: column;
    /* The drawer is the one full-bleed surface on the site, so it is the one
       place the notch and home indicator can actually clip content. */
    padding:
      calc(var(--gutter) + env(safe-area-inset-top))
      calc(var(--gutter) + env(safe-area-inset-right))
      calc(var(--gutter) + env(safe-area-inset-bottom))
      calc(var(--gutter) + env(safe-area-inset-left));
    background: var(--sumi);
    color: var(--washi);
    /* §4.5 — the drawer is where mobile meets the site's motion language, and
       it used to be the one hard cut in a system that choreographs everything
       else. Fade the surface, rise the entries behind it. */
    opacity: 0;
    transition: opacity 0.26s var(--ease-rise);
  }
  .drawer.is-open { opacity: 1; }
  .drawer[hidden] { display: none; }
  .drawer-top { display: flex; justify-content: flex-end; }
  .drawer-close {
    width: 44px;
    height: 44px;
    background: none;
    border: 1px solid var(--line-inv);
    color: inherit;
    font-size: 1.25rem;
    line-height: 1;
    cursor: pointer;
  }
  .drawer nav { display: grid; gap: 6px; margin-block: auto; }
  .drawer nav a {
    padding: 8px 0;
    border-bottom: 1px solid var(--line-inv);
    font-family: var(--font-display);
    font-size: clamp(1.875rem, 9vw, 2.75rem);
    text-decoration: none;
    opacity: 0;
    transform: translateY(12px);
    transition:
      opacity 0.4s var(--ease-rise),
      transform 0.4s var(--ease-rise);
  }
  .drawer.is-open nav a { opacity: 1; transform: none; }
  .drawer nav a:nth-child(1) { transition-delay: 0.05s; }
  .drawer nav a:nth-child(2) { transition-delay: 0.11s; }
  .drawer nav a:nth-child(3) { transition-delay: 0.17s; }
  .drawer nav a:nth-child(4) { transition-delay: 0.23s; }
  .drawer nav a:nth-child(5) { transition-delay: 0.29s; }
  .drawer nav a[aria-current='page'] { color: var(--niwa-2); }

  /* The conversion action was set identically to the four page links, so it
     read as a fifth page. The gold rule and tracked caps mark it as an act
     rather than a destination, matching Action's "rule" variant (§5.3). */
  .drawer-cta {
    display: flex;
    align-items: center;
    min-height: 44px;          /* §9 — the type alone would leave 27px. */
    margin-top: 10px;
    border-bottom-color: var(--kanmuri);
    font-family: var(--font-body);
    font-size: var(--t-eyebrow);
    letter-spacing: 0.2em;
    text-transform: uppercase;
  }

  .drawer-foot {
    font-size: var(--t-meta);
    letter-spacing: 0.2em;
    text-transform: uppercase;
    color: var(--koke);
  }
  .drawer :focus-visible { outline-color: var(--niwa-2); }
</style>
