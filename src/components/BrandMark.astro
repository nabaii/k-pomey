---
/**
 * [ASSET] Placeholder for the client's existing logo mark.
 * The screens show a circular badge carrying the firm's own device; that
 * artwork has not been supplied. This is a restrained stand-in drawn from the
 * same palette, sized and positioned exactly as the real mark will be — swap
 * the <svg> contents and nothing else moves.
 */
interface Props {
  inverted?: boolean;
}
const { inverted = false } = Astro.props;
const disc = inverted ? 'var(--washi)' : 'var(--sumi)';
const stem = inverted ? 'var(--niwa)' : 'var(--niwa-2)';
const leaf = inverted ? 'var(--kanmuri-d)' : 'var(--kanmuri)';
---

<svg viewBox="0 0 40 40" aria-hidden="true" focusable="false">
  <circle cx="20" cy="20" r="19" fill={disc}></circle>
  <path d="M20 31V16" stroke={stem} stroke-width="1.6" fill="none"></path>
  <path
    d="M20 19c0-4-2.6-6.2-6.4-6.2C13.6 16.8 16.2 19 20 19zm0 0c0-4 2.6-6.2 6.4-6.2C26.4 16.8 23.8 19 20 19z"
    fill={leaf}></path>
  <circle cx="20" cy="11.6" r="2.3" fill={stem}></circle>
</svg>

<style>
  svg { width: 30px; height: 30px; flex: none; }
</style>
