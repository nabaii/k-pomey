---
import { render } from 'astro:content';
import Base from '../../layouts/Base.astro';
import Slot from '../../components/Slot.astro';
import BeforeAfter from '../../components/BeforeAfter.astro';
import Forward from '../../components/Forward.astro';
import { linkableProjects, type Project } from '../../lib/projects';

/**
 * §7.3 PROJECT PAGES — "the Work grid answers *do they do good work*; a
 * project page answers *do they know what they are doing*."
 *
 * The spec's §7.3 asks for "one template, copied per project", so that a
 * non-developer can add a project by copying a file and editing the text
 * between numbered comment markers. That instruction exists to work around
 * hand-authored HTML. Here the template is the template: every project page
 * is generated from this one file, so the portfolio cannot drift and there is
 * nothing to keep in sync. Adding a project is a content file, not a copy.
 *
 * A project only gets a page when linkable is true — otherwise its card
 * points nowhere and no dead URL is generated (§3.3, §12.3).
 */
export async function getStaticPaths() {
  const projects = await linkableProjects();
  return projects.map((project) => ({
    params: { slug: project.id },
    props: { project },
  }));
}

interface Props {
  project: Project;
}
const { project } = Astro.props;
const d = project.data;
const { Content } = await render(project);

// §7.3 — "Projects without a matched before/after pair omit section 4
// entirely; the page still reads."
const hasReveal = Boolean(d.hasBeforeAfter && d.before && d.after);
---

<Base
  title={`${d.title}, ${d.location.split(',')[0]} — K. Pomey Landscaping and Alatu`}
  description={d.summary}
  bar={{
    href: '/work/',
    label: 'All work',
    message: `Hello K. Pomey, I saw the ${d.title.toLowerCase()} on your website and would like something similar.`,
  }}
>
  {/* ---- 1 · HERO IMAGE --------------------------------------------- */}
  <div class="hero">
    <Slot
      src={d.hero.src}
      alt={d.hero.alt}
      label={d.hero.label}
      tone={d.hero.tone}
      priority
      sizes="100vw"
    />
  </div>

  {/* ---- 2 · TITLE --------------------------------------------------- */}
  <section class="section-tight">
    <div class="wrap">
      <p class="eyebrow"><a class="crumb" href="/work/">Work</a> &middot; {d.category}</p>
      <h1 class="page-title title">{d.title}</h1>
      <div class="chips">
        <span class="chip">{d.location.split(',')[0]}</span>
        <span class="chip">{d.year}</span>
        <span class="chip">{d.duration}</span>
        {/* §4.1 — this page's single --heat accent: the care status, which is
            also the thing that routes the reader to Care (§7.3). */}
        {d.careStatus !== 'Not on care' && <span class="chip heat">{d.careStatus}</span>}
      </div>
    </div>
  </section>

  <div class="wrap"><hr class="rule" /></div>

  {/* ---- 3 · BRIEF + FACTS ------------------------------------------- */}
  <section class="section-tight">
    <div class="wrap two">
      <div>
        <p class="eyebrow">The site as we found it</p>
        <div class="prose"><Content /></div>

        {
          d.scope.length > 0 && (
            <>
              <h2 class="did">What we did</h2>
              <ul class="scope">
                {d.scope.map((item) => <li>{item}</li>)}
              </ul>
            </>
          )
        }
      </div>

      {
        d.facts.length > 0 && (
          <div>
            <p class="eyebrow">Project facts</p>
            <dl class="facts">
              {d.facts.map((f) => (
                <div>
                  <dt>{f.label}</dt>
                  <dd>{f.value}</dd>
                </div>
              ))}
            </dl>
          </div>
        )
      }
    </div>
  </section>

  {/* ---- 4 · BEFORE / AFTER ------------------------------------------ */}
  {
    hasReveal && (
      <section class="section-tight">
        <div class="wrap">
          <div class="reveal rise">
            <BeforeAfter before={d.before!} after={d.after!} />
            <div class="reveal-text ink">
              <p class="eyebrow">Same spot, {d.duration} apart</p>
              <h2 class="reveal-h">From dirt to drip.</h2>
              {d.revealNote && <p class="note">{d.revealNote}</p>}
            </div>
          </div>
        </div>
      </section>
    )
  }

  {/* ---- 5 · GALLERY -------------------------------------------------- */}
  {
    d.gallery.length > 0 && (
      <section class="section-tight">
        <div class="wrap">
          <p class="eyebrow">The garden</p>
          <div class="gallery">
            {d.gallery.map((g) => (
              <figure class={g.size}>
                <Slot
                  src={g.src}
                  alt={g.alt}
                  label={g.label}
                  tone={g.tone}
                  sizes="(min-width: 901px) 33vw, 50vw"
                />
                {/* §7.3 — captions on wide tiles only. */}
                {g.size === 'wide' && g.caption && <figcaption>{g.caption}</figcaption>}
              </figure>
            ))}
          </div>
        </div>
      </section>
    )
  }

  {/* ---- 6 · NOTE ----------------------------------------------------- */}
  {
    d.closingNote && (
      <section class="pull">
        <div class="pull-inner">
          <p>{d.closingNote}</p>
        </div>
      </section>
    )
  }

  {/* ---- 7 · NEXT ------------------------------------------------------ */}
  <section class="section">
    <div class="wrap">
      <Forward href="/work/" label="All work" meta="Portfolio" />
      <Forward href="/studio/#contact" label="Start a garden like this" meta="Book a site visit" />
    </div>
  </section>
</Base>

<style>
  .hero { aspect-ratio: 4 / 3; }
  @media (min-width: 901px) {
    .hero { aspect-ratio: 16 / 10; }
  }

  .crumb { text-decoration: none; }
  .crumb:hover { color: var(--niwa); }
  .title { margin: 6px 0 16px; }

  .chips { display: flex; flex-wrap: wrap; gap: 8px 22px; }
  .chip {
    display: flex;
    align-items: center;
    gap: 8px;
    font-size: var(--t-meta);
    letter-spacing: 0.2em;
    text-transform: uppercase;
    color: var(--koke-d);
  }
  .chip::before { content: ''; flex: none; width: 5px; height: 5px; background: var(--kanmuri); }
  .chip.heat { color: var(--heat); }
  .chip.heat::before { background: var(--heat); }

  .two { display: grid; gap: clamp(34px, 5vw, 64px); }
  @media (min-width: 901px) {
    .two { grid-template-columns: 1.35fr 1fr; }
  }

  .prose :global(p + p) { margin-top: 18px; }

  .did { margin: clamp(30px, 4vw, 46px) 0 6px; font-size: clamp(1.375rem, 2.4vw, 1.875rem); }
  .scope li {
    display: flex;
    gap: 14px;
    padding: 11px 0;
    border-bottom: 1px solid var(--line);
    font-size: 0.875rem;
  }
  .scope li::before { content: '—'; flex: none; color: var(--kanmuri-d); }

  .facts div {
    display: flex;
    justify-content: space-between;
    gap: 20px;
    padding: 12px 0;
    border-bottom: 1px solid var(--line);
    font-size: var(--t-note);
  }
  .facts dt {
    flex: none;
    padding-top: 3px;
    font-size: var(--t-meta);
    letter-spacing: 0.2em;
    text-transform: uppercase;
    color: var(--koke-d);
  }
  .facts dd { margin: 0; max-width: 22ch; text-align: right; }

  .reveal { display: grid; }
  .reveal-text { padding: clamp(24px, 3vw, 38px); }
  .reveal-h { margin-bottom: 12px; font-size: clamp(1.3125rem, 2.4vw, 1.75rem); }

  /* §7.3 — six tiles, mixed ratios. */
  .gallery {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: clamp(10px, 1.4vw, 18px);
  }
  .gallery figure { position: relative; margin: 0; aspect-ratio: 1; }
  .gallery figure.wide { grid-column: span 2; aspect-ratio: 16 / 9; }
  figcaption {
    position: absolute;
    left: 0;
    right: 0;
    bottom: 0;
    padding: 14px;
    background: linear-gradient(transparent, color-mix(in srgb, var(--sumi) 78%, transparent));
    color: var(--washi);
    font-size: var(--t-meta);
    letter-spacing: 0.2em;
    text-transform: uppercase;
  }
  @media (min-width: 901px) {
    .gallery { grid-template-columns: repeat(3, 1fr); }
  }

  .pull { padding: clamp(34px, 5vw, 58px) var(--gutter); background: var(--washi-2); }
  .pull-inner { max-width: var(--container); margin-inline: auto; }
  .pull p {
    max-width: 20ch;
    padding-left: 24px;
    border-left: 2px solid var(--kanmuri);
    font-family: var(--font-display);
    font-size: clamp(1.3125rem, 2.8vw, 2rem);
    line-height: 1.25;
  }
</style>
