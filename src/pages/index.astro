---
import Base from '../layouts/Base.astro';
import PlanDrawing from '../components/PlanDrawing.astro';
import TitleBlock from '../components/TitleBlock.astro';
import Diptych from '../components/Diptych.astro';
import Sheet from '../components/Sheet.astro';
import IndexList from '../components/IndexList.astro';
import Action from '../components/Action.astro';
import { homeIndex } from '../lib/projects';

/**
 * §7.1 HOME — "establish the firm's seriousness in one screen, then make the
 * visitor pick a direction. Nothing here is exhaustive."
 *
 * Sheet numbering is the page's spine: 01 Setting out → 02 Selected work →
 * 03 Alatu — garden care → 04 Elsewhere.
 */
const projects = await homeIndex();

const chips = ['Abuja, FCT', 'Landscaping · Flowers · Care'];
const elsewhere = [
  { href: '/flowers/', label: 'Supply & install', title: 'Flowers' },
  { href: '/studio/', label: 'About & process', title: 'The studio' },
  { href: '/studio/#contact', label: 'Contact', title: 'Book a site visit' },
];
---

<Base
  title="K. Pomey Landscaping and Alatu — Landscaping, flowers and garden care in Abuja"
  description="We draw a garden before we dig it, build it with our own crew, and come back every month to keep it. Landscaping, flowers and garden care in Abuja."
  omitFooterLink="Home"
  bar={{
    href: '/work/',
    label: 'See the work',
    message: 'Hello K. Pomey, I saw your website and would like to talk about a garden.',
  }}
>
  {/* ---- 01 · SETTING OUT ------------------------------------------- */}
  <section class="hero">
    <div class="survey-grid" aria-hidden="true"></div>
    <div class="hero-inner">
      <div class="hero-grid">
        <div class="hero-text">
          <div class="chips">
            {chips.map((c) => <span class="chip">{c}</span>)}
          </div>

          <h1>The art of <em>landscaping</em></h1>

          {/* §7.1 — hero lede is two sentences maximum. Resist expansion. */}
          <p class="lede hero-lede">
            We draw a garden before we dig it, build it with our own crew, and come
            back every month to keep it. Seven weeks or two — the drawing comes
            first either way.
          </p>

          {/* §5.3 — a joined pair sharing one border, reading as a single
              drawn control. Home only. */}
          <div class="hero-actions">
            <Action href="/work/" arrow>See the work</Action>
            <Action href="/studio/#contact" variant="ghost">Book a site visit</Action>
          </div>

          <p class="setting-out">01 &nbsp;—&nbsp; Setting out</p>
        </div>

        <div class="hero-plan">
          <PlanDrawing />
          <div class="plan-foot">
            <span class="meta">Setting out</span>
            <TitleBlock sheet="01" scale="1:100" rev="A" />
          </div>
        </div>
      </div>
    </div>
  </section>

  {/* ---- THE DIPTYCH ------------------------------------------------ */}
  <Diptych />

  {/* ---- 02 · SELECTED WORK ----------------------------------------- */}
  <section class="section">
    <div class="wrap">
      <Sheet n="02" label="Selected work" />
      <h2 class="rise section-heading">From dirt to<br />drip.</h2>
      <IndexList projects={projects} />
      <p class="all-work">
        <Action href="/work/" variant="ghost" arrow>All work</Action>
      </p>
    </div>
  </section>

  {/* ---- 03 · ALATU — GARDEN CARE ----------------------------------- */}
  <section class="care-band ink section-tight">
    <div class="care-inner">
      <Sheet n="03" label="Alatu — garden care" />
      <div class="rise">
        <h2 class="care-heading">The garden you paid for,<br />twelve months a year.</h2>
        <p class="lede care-lede">
          Most gardens in Abuja are lost in the dry season, not the wet one. A fixed
          monthly visit costs a fraction of replanting — and your garden is never
          between gardeners.
        </p>
        <Action href="/care/" variant="rule" arrow>See care plans</Action>
      </div>
    </div>
  </section>

  {/* ---- 04 · ELSEWHERE --------------------------------------------- */}
  <section class="section">
    <div class="wrap">
      <Sheet n="04" label="Elsewhere" />
      <div class="close rise">
        {
          elsewhere.map((e) => (
            <a href={e.href}>
              <span class="meta">{e.label}</span>
              <b>{e.title}</b>
            </a>
          ))
        }
      </div>
    </div>
  </section>
</Base>

<style>
  /* ---- hero -------------------------------------------------------- */
  .hero {
    position: relative;
    overflow: hidden;
    padding-block: clamp(30px, 5vw, 68px) clamp(50px, 7vw, 96px);
  }
  .hero-inner {
    position: relative;
    z-index: 2;
    max-width: var(--container);
    margin-inline: auto;
    padding-inline: var(--gutter);
  }
  .hero-grid { display: grid; gap: 30px; }

  .chips { display: flex; flex-wrap: wrap; gap: 10px 26px; margin-bottom: 26px; }
  .chip {
    display: flex;
    align-items: center;
    gap: 9px;
    font-size: var(--t-meta);
    letter-spacing: 0.2em;
    text-transform: uppercase;
    color: var(--koke-d);
  }
  .chip::before { content: ''; width: 14px; height: 1px; background: var(--kanmuri); }

  h1 {
    margin-bottom: 26px;
    font-size: var(--t-hero);
    line-height: 0.88;
    letter-spacing: -0.038em;
  }
  h1 em { display: block; font-style: normal; color: var(--niwa); }

  /* §4.2 — hero lede caps at 44ch. */
  .hero-lede { max-width: 44ch; margin-bottom: 32px; }

  .hero-actions { display: inline-flex; flex-direction: column; }
  .hero-actions :global(a) { border-color: var(--sumi); }
  .hero-actions :global(a + a) { border-top-width: 0; }
  @media (min-width: 561px) {
    .hero-actions { flex-direction: row; }
    .hero-actions :global(a + a) { border-top-width: 1px; border-left-width: 0; }
  }

  .setting-out {
    margin-top: 34px;
    font-size: var(--t-ann);
    letter-spacing: 0.2em;
    text-transform: uppercase;
    color: var(--koke-d);
  }

  /* Mobile: the plan sits behind the text, faded, as in the screens. */
  .hero-plan {
    position: absolute;
    inset: auto 0 0 24%;
    z-index: 1;
    opacity: 0.5;
  }
  .plan-foot { display: none; }

  /* §7.1 — "the plan sits right of centre and is masked to fade at the
     edges; the headline must never overlap dense linework." The mask does
     the work, so the columns can overlap by one and the drawing still
     resolves behind the type. Checked at 1024, 1440 and 1920. */
  @media (min-width: 861px) {
    .hero-grid { grid-template-columns: repeat(12, 1fr); align-items: center; gap: 0; }
    .hero-text { grid-column: 1 / 8; grid-row: 1; z-index: 2; }
    .hero-plan {
      position: relative;
      inset: auto;
      grid-column: 7 / 13;
      grid-row: 1;
      opacity: 1;
    }
    /* The mask belongs to the linework alone. Applied to the whole column it
       also ate the title block and its label, which are drafting furniture
       that must stay legible. */
    .hero-plan :global(.plan) {
      mask-image: linear-gradient(90deg, transparent, #000 14%, #000 97%, transparent);
    }
    .plan-foot {
      display: flex;
      align-items: flex-end;
      justify-content: space-between;
      gap: 20px;
      margin-top: 14px;
    }
    .plan-foot :global(.tblock) { width: 190px; }
  }

  /* ---- 02 index ---------------------------------------------------- */
  .section-heading { margin-bottom: clamp(30px, 4vw, 54px); }
  .all-work { margin-top: clamp(28px, 4vw, 44px); max-width: none; }

  /* ---- 03 care band ------------------------------------------------ */
  .care-band { margin-inline: var(--gutter); }
  .care-inner { padding-inline: clamp(24px, 4vw, 56px); }
  .care-heading { margin-bottom: 20px; }
  .care-lede { margin-bottom: 30px; }

  /* ---- 04 elsewhere ------------------------------------------------ */
  .close { display: grid; border: 1px solid var(--line); }
  .close a {
    padding: 26px;
    border-bottom: 1px solid var(--line);
    text-decoration: none;
  }
  .close a:last-child { border-bottom: 0; }
  .close b {
    display: block;
    margin-top: 8px;
    font-family: var(--font-display);
    font-size: clamp(1.25rem, 2vw, 1.625rem);
    font-weight: 400;
    transition: color 0.3s;
  }
  .close a:hover b { color: var(--niwa); }

  @media (min-width: 761px) {
    .close { grid-template-columns: repeat(3, 1fr); }
    .close a { border-bottom: 0; border-right: 1px solid var(--line); }
    .close a:last-child { border-right: 0; }
  }
</style>
