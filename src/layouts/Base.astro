---
import { Font } from 'astro:assets';
import Nav from '../components/Nav.astro';
import Rail from '../components/Rail.astro';
import Footer from '../components/Footer.astro';
import ActionBar from '../components/ActionBar.astro';
import { site, instagramUrl } from '../lib/site';
import '../styles/global.css';

interface Props {
  title: string;
  description: string;
  /** Care inverts to ink for the whole page (§7.5). */
  inverted?: boolean;
  /** Page name to omit from the footer's secondary nav. */
  omitFooterLink?: string;
  bar: { href: string; label: string; message: string };
}

const { title, description, inverted = false, omitFooterLink, bar } = Astro.props;
const canonical = new URL(Astro.url.pathname, Astro.site).href;

/**
 * §1.3 — the site's job is to "make a contractor look like a firm, to a person
 * who has already heard the name". Structured data is part of surviving that
 * check: it lets the firm's details resolve consistently wherever they are
 * quoted back. This is not an SEO play — §1.3 puts search traffic out of scope.
 */
const businessSchema = {
  '@context': 'https://schema.org',
  '@type': 'LandscapingBusiness',
  name: 'K. Pomey Landscaping and Alatu',
  description:
    'Landscaping, flowers and garden care in Abuja. Registered in Nigeria.',
  url: `https://${site.domain}`,
  telephone: `+${site.whatsapp}`,
  email: site.email,
  address: {
    '@type': 'PostalAddress',
    streetAddress: site.officeLine1,
    addressLocality: 'Abuja',
    addressRegion: 'FCT',
    addressCountry: 'NG',
  },
  areaServed: site.serviceArea,
  openingHours: 'Mo-Sa 08:00-18:00',
  sameAs: [instagramUrl],
};
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width,initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />

    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="K. Pomey Landscaping and Alatu" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="theme-color" content="#161A17" />

    <!-- §4.2 — self-hosted, latin-subset, metric-matched fallbacks. -->
    <Font cssVariable="--font-display" preload={[{ weight: 400 }]} />
    <Font cssVariable="--font-body" preload={[{ weight: 300 }]} />

    <script type="application/ld+json" set:html={JSON.stringify(businessSchema)} is:inline />
  </head>

  <body class:list={{ 'has-rail': true, ink: inverted }}>
    <a class="skip-link" href="#main">Skip to content</a>

    <Rail inverted={inverted} />
    <Nav inverted={inverted} />

    <main id="main">
      <slot />
    </main>

    <Footer omit={omitFooterLink} />
    <ActionBar secondaryHref={bar.href} secondaryLabel={bar.label} message={bar.message} />

    <script>
      /**
       * §4.5 — section entrance: fade + 16px rise, staggered 65ms in groups of
       * four. Secondary motion: the scribe is the signature and nothing beside
       * it animates. Reduced motion is handled in CSS, but we also skip the
       * observer entirely so nothing is left mid-transition.
       */
      const reduced = matchMedia('(prefers-reduced-motion: reduce)').matches;
      const targets = document.querySelectorAll<HTMLElement>('.rise');

      if (reduced || !('IntersectionObserver' in window)) {
        targets.forEach((el) => el.classList.add('is-in'));
      } else {
        const io = new IntersectionObserver(
          (entries) => {
            entries.forEach((entry, i) => {
              if (!entry.isIntersecting) return;
              const el = entry.target as HTMLElement;
              el.style.transitionDelay = `${(i % 4) * 65}ms`;
              el.classList.add('is-in');
              io.unobserve(el);
            });
          },
          { rootMargin: '0px 0px -12% 0px' },
        );
        targets.forEach((el) => io.observe(el));
      }
    </script>

    <style is:global>
      /* §5.10 — body clears the fixed bar; released at 821px (§8). */
      body { padding-bottom: calc(var(--bar-h) + env(safe-area-inset-bottom)); }
      @media (min-width: 821px) {
        body { padding-bottom: 0; }
      }
      /* §5.2 — the rail appears at 1101px and the body makes room for it. */
      @media (min-width: 1101px) {
        body.has-rail { padding-left: var(--rail-w); }
      }
    </style>
  </body>
</html>
